import "tfplan/v2" as tfplan

# Safely retrieve security groups, defaulting to an empty map if missing/undefined
security_groups = tfplan.resources["aws_security_group"] else {}

main = rule {
  # Rule Check A: No Security Group allows SSH (port 22) from 0.0.0.0/0
  (all security_groups as _, sg {
    all (sg.change.after.ingress else []) as ingress_rule {
      not (((ingress_rule.from_port else 0) <= 22) and ((ingress_rule.to_port else 0) >= 22) and ("0.0.0.0/0" in (ingress_rule.cidr_blocks else [])))
    }
  }) and

  # Rule Check B: Database Security Group has NO direct CIDR block rules
  (all security_groups as _, sg {
    ((sg.change.after.name else "") != "db-tier-sg") or (all (sg.change.after.ingress else []) as ingress_rule {
      length(ingress_rule.cidr_blocks else []) == 0
    })
  })
}